{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raavi-volt",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "raavi-volt" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raavi-volt-db",
      // Replace with the id printed by `wrangler d1 create raavi-volt-db`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "raavi-volt-media" }
  ],
  // Workers Rate Limiting: 10 requests / 60s per key (login, checkout, tracking).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
