{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raavi-volt",
  // worker.ts wraps the OpenNext handler with the edge page cache.
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "raavi-volt" }
  ],
  // Everything runs on Cloudflare's free plan: Workers + D1 only. Both have hard
  // free limits (requests fail instead of being billed) and need no card.
  // Product images, payment proofs and rate limits are stored in D1.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raavi-volt-db",
      "database_id": "57304134-7cc0-4044-a9c3-63e2fa2ab99f",
      "migrations_dir": "migrations"
    }
  ],
  // Optional, for much larger catalogs: bind an R2 bucket and files move there
  // automatically (R2 needs a card and bills usage above its free tier).
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "raavi-volt-media" }],
  // Deployment id, used to start a fresh page cache on every deploy (free).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  // Nightly housekeeping at 21:15 UTC (02:15 PKT): release stock from unpaid
  // orders older than 72 h and prune old logs. Cron Triggers are free.
  "triggers": { "crons": ["15 21 * * *"] },
  // Custom domain. Uncomment after amirstore.tech is added to your Cloudflare
  // account (registrar nameservers pointed to Cloudflare). Until then the store
  // is served at https://raavi-volt.<your-subdomain>.workers.dev.
  // "routes": [
  //   { "pattern": "amirstore.tech", "custom_domain": true },
  //   { "pattern": "www.amirstore.tech", "custom_domain": true }
  // ],
  "workers_dev": true
}
